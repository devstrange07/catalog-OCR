DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Required for Stage-2 extraction (all channels) and for Gemini / Unlimited-OCR Stage 1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PARSE_CHANNEL_DEFAULT=paddleocr
OCR_LANG=en
OCR_USE_GPU=false
OCR_GPU_ID=0
HOST=0.0.0.0
PORT=8000
CRAWL_TIMEOUT_SEC=60
CRAWL_HEADLESS=true
# Unlimited-OCR channel (requires CUDA GPU when no remote URL; GEMINI_API_KEY for Stage 2)
UNLIMITED_OCR_MODEL=baidu/Unlimited-OCR
UNLIMITED_OCR_GPU_ID=0
UNLIMITED_OCR_MAX_LENGTH=32768
UNLIMITED_OCR_BASE_SIZE=1024
UNLIMITED_OCR_IMAGE_SIZE=640
UNLIMITED_OCR_NO_REPEAT_NGRAM_SIZE=35
UNLIMITED_OCR_NGRAM_WINDOW=128
# Optional: point Unlimited-OCR at a Colab-hosted endpoint instead of running locally
UNLIMITED_OCR_REMOTE_URL=
UNLIMITED_OCR_REMOTE_API_KEY=
UNLIMITED_OCR_REMOTE_TIMEOUT_SEC=180
